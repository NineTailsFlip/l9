<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Recents (RecentsActivity): bringing a task back and closing one. On the thor2 image L9 is
         the recents component, and Android grants these two to that package; REORDER_TASKS is
         the ordinary fallback for opening. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission
        android:name="android.permission.START_TASKS_FROM_RECENTS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.REMOVE_TASKS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".L9Application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nine"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Started by the system for the Recents key (ro.config.thor2_recents on thor2) in a
             task of its own, so going back from it never lands on L9's home screen by accident;
             singleTask so a second press reaches onNewIntent and closes it. -->
        <activity
            android:name=".RecentsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.ninetailsflip.l9.recents"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".RenameActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".CalendarSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".SpeedDialSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <service
            android:name=".NotificationListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
